# Response headers for every file (Cloudflare Workers static assets).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin

# the page: only its own files run. The one inline script (the backdrop in <head>) is allowed by its hash, so
# editing it means updating the hash here (the console names the hash it expected). Inline style attributes stay
# allowed for the name SVGs' --r; images may be data: URLs (shimmer strip, parchment grain). Cloudflare Web Analytics
# (injected by Cloudflare for browsers) loads its beacon from static.cloudflareinsights.com and reports to /cdn-cgi/rum on this domain (or cloudflareinsights.com).
/
  Content-Security-Policy: default-src 'none'; script-src 'self' 'sha256-aQYo25QS+klvlA7VmnmHB/S3S+hZCQyV6qs3beoL/U4=' https://static.cloudflareinsights.com; connect-src 'self' https://cloudflareinsights.com; style-src-elem 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

# the pixel-art portrait stays out of image search; the photo (assets/portrait.jpg) is the one image meant to be found
/assets/portrait-pixel.png
  X-Robots-Tag: noindex

# the résumé is fetched only when its button is clicked, and stays out of search results (name only, see AGENTS.md)
/rounakbera_resume.pdf
  X-Robots-Tag: noindex
